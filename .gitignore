# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# C++ build
build/

# Generated traces (regenerate with `python -m tokenwall gen`; .meta.json stays as evidence)
traces/*.segs
traces/*.bin
traces/*.trace
traces/*.txt
!traces/README.md

# OS
.DS_Store

# Synthetic smoke traces under results/ are regenerated by the scripts
results/**/*.trace

# pip editable-install metadata
*.egg-info/

# Command traces from validation runs (regenerate with --cmd-trace; tens of MB each)
traces/cmdtrace_*
traces/*.csv
traces/*.ch[0-9]*
